{
  "permissions": {
    "allow": [
      "Bash(bun test*)",
      "Bash(bunx tsc --noEmit*)",
      "Bash(bun evals/run.ts*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)"
    ],
    "deny": [
      "Bash(npm publish*)",
      "Bash(bun publish*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Read(~/.config/pocketbrain/keys/**)",
      "Read(./.env*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.ts\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR/.claude/hooks/after-edit.ts\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && bun install --frozen-lockfile >/dev/null 2>&1; echo 'pocketBrain harness: git hooks on (pre-commit, pre-push); guard.ts active. Laws in CLAUDE.md.'"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop-check.ts\""
          }
        ]
      }
    ]
  }
}
